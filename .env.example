# Base de données
METEO_DSN=postgresql+psycopg://meteo:meteo@localhost:5433/meteo

# Jeton Infoclimat (https://www.infoclimat.fr/opendata/ — compte requis).
# Attention : le jeton est lié à une adresse IP déclarée. Le backfill des Observations
# doit donc tourner depuis la machine dont l'IP a été déclarée, typiquement le VPS.
METEO_JETON_INFOCLIMAT=

# Centre et rayon de la zone couverte (Grenoble par défaut)
METEO_CENTRE_LAT=45.1885
METEO_CENTRE_LON=5.7245
METEO_RAYON_KM=20

# Première date backfillée. L'archive Previous Runs d'Open-Meteo démarre
# le 20/01/2024 pour AROME et ICON-D2, le 04/02/2024 pour ECMWF.
METEO_DEBUT_HISTORIQUE=2024-02-04

# ─── Déploiement sur le VPS uniquement ───────────────────────────────────────
# Laissez ces trois lignes commentées en développement.

# Active les services « web » et « proxy » de docker compose. Sans cette ligne,
# « docker compose up -d » ne démarre que la base et le lot.
# COMPOSE_PROFILES=vps

# Nom de domaine servi par le proxy. Il doit déjà pointer sur l'IP du VPS :
# c'est ainsi que Let's Encrypt vérifie que le domaine est bien à vous.
# METEO_DOMAINE=meteo.mondomaine.fr

# Départements dont les séries longues Météo-France sont chargées, séparés par des
# virgules. C'est la maille de publication des fichiers, pas un choix de périmètre :
# un département voisin s'ajoute ici puis se charge par `meteo climatologie`, sans
# rien recharger du reste.
# METEO_DEPARTEMENTS_CLIMAT=38

# Mot de passe de la base. N'est pris en compte qu'à la première initialisation
# du volume — le changer ensuite ne change rien, il faut recréer le volume.
# Tous les caractères sont acceptés, y compris « @ », « / » et « # » : le mot de
# passe ne transite pas par une URL. Ne le mettez pas entre guillemets, compose
# les prendrait pour une partie du mot de passe.
# METEO_MDP_BASE=un-mot-de-passe-long-et-unique
